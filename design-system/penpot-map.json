    "variants": {
      "Button": ["Primary", "Secondary", "Ghost", "Destructive", "Disabled"],
      "StateBadge": ["Observed", "Inferred", "Simulated", "Verified", "Needs review", "Stale", "Blocked", "Draft"],
      "SidebarNavItem": ["Default", "Hover", "Active"],
      "SourceBanner": ["Verified", "Missing", "Stale"],
      "Panel": ["Default", "Soft", "Modal"]
    },
